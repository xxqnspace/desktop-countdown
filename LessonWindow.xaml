<Window x:Class="DesktopCountdown.LessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="84"
        MinWidth="200"
        MinHeight="56"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Grid>
        <Border x:Name="RootBorder"
                CornerRadius="18"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Grid>
                <!-- 经典 Aero 玻璃质感叠加层：位于内容之下，不参与命中测试 -->
                <Border x:Name="AeroHighlightBorder" CornerRadius="17" IsHitTestVisible="False" />
                <Border x:Name="AeroSheenBorder" CornerRadius="17" IsHitTestVisible="False" />
                <Grid Margin="18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PrimaryText"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SecondaryText"
                               Grid.Row="1"
                               FontWeight="Bold"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
