<Window x:Class="DesktopCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面倒计时设置"
        Width="720"
        Height="800"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </Window.Resources>
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,22" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="桌面倒计时" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="设置目标时间、显示单位和悬浮窗外观。关闭此窗口后，悬浮窗会继续运行。"
                           Margin="0,8,0,0"
                           Foreground="#6B7280" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <TabControl Margin="24" Background="Transparent">
                <TabItem Header="倒计时">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,16,0,0">
                <GroupBox Header="倒计时" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="标题" />
                        <TextBox x:Name="TitleBox" Grid.Column="1" />

                        <TextBlock Grid.Row="1" Text="目标日期" Margin="0,12,0,0" />
                        <DatePicker x:Name="TargetDatePicker" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" />

                        <TextBlock Grid.Row="2" Text="目标时间" Margin="0,12,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <ComboBox x:Name="TargetHourBox" Width="80" />
                            <TextBlock Text="时" Margin="8,0,16,0" />
                            <ComboBox x:Name="TargetMinuteBox" Width="80" />
                            <TextBlock Text="分" Margin="8,0,16,0" />
                            <ComboBox x:Name="TargetSecondBox" Width="80" />
                            <TextBlock Text="秒" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="结束文案" Margin="0,12,0,0" />
                        <TextBox x:Name="EndTextBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="显示单位" Padding="16" Margin="0,0,0,16">
                    <WrapPanel>
                        <CheckBox x:Name="ShowDaysBox" Content="天" Margin="0,0,24,8" />
                        <CheckBox x:Name="ShowHoursBox" Content="时" Margin="0,0,24,8" />
                        <CheckBox x:Name="ShowMinutesBox" Content="分" Margin="0,0,24,8" />
                        <CheckBox x:Name="ShowSecondsBox" Content="秒" Margin="0,0,24,8" />
                        <CheckBox x:Name="CeilingDaysBox" Content="只显示天时向上取整" Margin="0,0,24,8" />
                    </WrapPanel>
                </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="外观">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,16,0,0">
                <GroupBox Header="外观" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="背景模式" />
                        <ComboBox x:Name="BackgroundModeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="BackgroundModeBox_SelectionChanged">
                            <ComboBoxItem Content="液态玻璃" Tag="LiquidGlass" />
                            <ComboBoxItem Content="纯色" Tag="Solid" />
                            <ComboBoxItem Content="渐变" Tag="Gradient" />
                            <ComboBoxItem Content="图片" Tag="Image" />
                            <ComboBoxItem Content="系统亚克力（Win11）" Tag="Acrylic" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="背景颜色" Margin="0,12,0,0" />
                        <TextBox x:Name="BackgroundColorBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" ToolTip="示例：#CCFFFFFF" />

                        <TextBlock Grid.Row="2" Text="文字颜色" Margin="0,12,0,0" />
                        <TextBox x:Name="TextColorBox" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" ToolTip="示例：#FFFFFFFF" />

                        <TextBlock Grid.Row="3" Text="透明度" Margin="0,12,0,0" />
                        <Slider x:Name="OpacitySlider" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Minimum="0.2" Maximum="1" TickFrequency="0.05" />

                        <TextBlock Grid.Row="4" Text="背景图片" Margin="0,12,0,0" />
                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,12,0,0">
                            <Button Content="选择图片" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ChooseImageButton_Click" />
                            <TextBox x:Name="BackgroundImageBox" IsReadOnly="True" />
                        </DockPanel>

                        <TextBlock Grid.Row="5" Text="亚克力着色" Margin="0,12,0,0" />
                        <TextBox x:Name="AcrylicTintBox" Grid.Row="5" Grid.Column="1" Margin="0,12,0,0" ToolTip="系统亚克力模式下的着色层，示例：#66111820" />

                        <TextBlock Grid.Row="6" Text="圆角" Margin="0,12,0,0" />
                        <TextBox x:Name="CornerRadiusBox" Grid.Row="6" Grid.Column="1" Margin="0,12,0,0" ToolTip="单位像素，0 为直角，示例：18" />

                        <TextBlock Grid.Row="7" Text="边框" Margin="0,12,0,0" />
                        <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,12,0,0">
                            <CheckBox x:Name="BorderEnabledBox" Content="显示边框" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <TextBox x:Name="BorderColorBox" Margin="12,0,0,0" ToolTip="边框颜色，示例：#66FFFFFF" />
                        </DockPanel>

                        <TextBlock Grid.Row="8" Text="字体" Margin="0,12,0,0" />
                        <TextBox x:Name="FontFamilyBox" Grid.Row="8" Grid.Column="1" Margin="0,12,0,0" ToolTip="示例：Segoe UI / 微软雅黑" />

                        <TextBlock Grid.Row="9" Text="强调色" Margin="0,12,0,0" />
                        <TextBox x:Name="AccentColorBox" Grid.Row="9" Grid.Column="1" Margin="0,12,0,0" ToolTip="仅「渐变」背景使用，示例：#7CB7FF" />

                        <TextBlock Grid.Row="10" Text="阴影模糊" Margin="0,12,0,0" />
                        <Slider x:Name="BlurRadiusSlider" Grid.Row="10" Grid.Column="1" Margin="0,12,0,0" Minimum="0" Maximum="60" TickFrequency="2" ToolTip="仅非亚克力模式生效" />

                        <TextBlock Grid.Row="11" Text="图片填充" Margin="0,12,0,0" />
                        <ComboBox x:Name="ImageStretchBox" Grid.Row="11" Grid.Column="1" Margin="0,12,0,0" ToolTip="仅「图片」背景使用">
                            <ComboBoxItem Content="裁剪填满（推荐）" Tag="UniformToFill" />
                            <ComboBoxItem Content="完整显示（可能留边）" Tag="Uniform" />
                            <ComboBoxItem Content="拉伸填满（可能变形）" Tag="Fill" />
                        </ComboBox>

                        <TextBlock Grid.Row="12" Text="玻璃质感" Margin="0,12,0,0" />
                        <CheckBox x:Name="AeroGlassBox"
                                  Grid.Row="12"
                                  Grid.Column="1"
                                  Margin="0,12,0,0"
                                  Content="经典 Aero 高光（顶部高光 + 斜向反射 + 边框发光）"
                                  ToolTip="叠加在背景之上，营造 Vista/7 玻璃质感" />

                        <TextBlock Grid.Row="13" Text="高光强度" Margin="0,12,0,0" />
                        <Slider x:Name="AeroIntensitySlider" Grid.Row="13" Grid.Column="1" Margin="0,12,0,0" Minimum="0" Maximum="1" TickFrequency="0.05" ToolTip="1 为默认；调低可减弱高光以免影响文字对比度" />
                    </Grid>
                </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="课程提醒">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,16,0,0">
                <GroupBox Header="课程提示" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="LessonEnabledBox" Content="启用课程提示窗口" Margin="0,0,24,8" />
                            <CheckBox x:Name="LessonFollowBox" Content="吸附在倒计时窗口下方" Margin="0,0,24,8" />
                        </WrapPanel>

                        <TextBlock Text="上课中显示「当前是第X节课 / 距下课还有XX分钟」，课间显示「下一节是第X节课 / 距上课还有X分钟」。"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"
                                   Foreground="#6B7280" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="节次" Foreground="#6B7280" />
                            <TextBlock Grid.Column="1" Text="上课" Margin="6,0,0,0" Foreground="#6B7280" />
                            <TextBlock Grid.Column="2" Text="下课" Margin="6,0,0,0" Foreground="#6B7280" />
                        </Grid>

                        <ItemsControl x:Name="LessonList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                                        <TextBox Grid.Column="2" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                                        <Button Grid.Column="3" Content="删除" Margin="6,0,0,0" Click="RemoveLessonButton_Click" Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="添加一节课" Click="AddLessonButton_Click" />
                            <Button Content="恢复默认作息" Margin="8,0,0,0" Click="ResetLessonButton_Click" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文字颜色" />
                            <TextBox x:Name="LessonTextColorBox" Grid.Column="1" ToolTip="课程窗口文字颜色，示例：#FF000000" />
                            <TextBlock Grid.Column="2" Text="背景着色" Margin="12,0,0,0" />
                            <TextBox x:Name="LessonTintBox" Grid.Column="3" Margin="6,0,0,0" ToolTip="系统亚克力模式下的浅色着色，示例：#CCFFFFFF" />
                        </Grid>

                        <TextBlock Text="放学后文案" Margin="0,14,0,0" />
                        <TextBox x:Name="LessonIdleBox" Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="行为">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,16,0,0">
                <GroupBox Header="行为" Padding="16">
                    <WrapPanel>
                        <CheckBox x:Name="TopmostBox" Content="始终置顶" Margin="0,0,24,8" />
                        <CheckBox x:Name="LockedBox" Content="锁定位置" Margin="0,0,24,8" />
                        <CheckBox x:Name="AutoStartBox" Content="开机自启" Margin="0,0,24,8" />
                        <CheckBox x:Name="NotifyOnEndBox" Content="结束时通知" Margin="0,0,24,8" />
                    </WrapPanel>
                </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="24,16">
            <DockPanel>
                <TextBlock x:Name="StatusText" Foreground="#6B7280" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="隐藏悬浮窗" Margin="0,0,8,0" Click="HideWidgetButton_Click" />
                    <Button Content="保存并应用" FontWeight="SemiBold" Click="SaveButton_Click" />
                    <Button Content="退出应用" Margin="8,0,0,0" Click="ExitButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
