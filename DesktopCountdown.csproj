<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- PerMonitorV2：多显示器不同缩放时窗口不糊，且保存的 Left/Top 不会跨屏漂移 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 由 WinForms 分析器触发，要求改用 ApplicationHighDpiMode 属性。
         但本项目仅用 WinForms 的 NotifyIcon（无任何 WinForms 窗体），
         该属性需要配合 ApplicationConfiguration.Initialize() 才生效，对本项目无效，
         因此保留 WPF 正确做法（manifest 声明 DPI），仅屏蔽该条提示。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- 自包含单文件发布时把 WPF 原生库（wpfgfx / PresentationNative / D3DCompiler 等）
         一并打进 exe，否则产物旁边会散落 5 个 DLL，就不再是「单文件免安装」了。
         这些库在首次运行时释放到临时目录。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 作为程序集资源嵌入：托盘图标不再依赖发布目录下的 Assets 文件夹，发布后无需手工复制 -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
